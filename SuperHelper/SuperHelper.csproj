<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.0.3.1</Version>
    <Title>SuperHelperR9</Title>
    <Description>Much better help window for grasshoopper</Description>
    <TargetExt>.gha</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Authors>ArchiBC</Authors>
    <PackageIcon>SuperHelperIcon_128.png</PackageIcon>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	<IsPublishable>True</IsPublishable>
	  <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
	  <NoWarn>NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Grasshopper on macOS supplies its WinForms compatibility implementation at runtime. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="AlipayImage.jpg" />
    <None Remove="Resources\SuperHelperIcon_24.png" />
    <None Remove="WeChatPayImage.jpg" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\SuperHelperIcon_24.png" />
    <EmbeddedResource Include="Resources\Panels\*.svg" />
    <EmbeddedResource Include="Resources\urls.rhino-cn.json" LogicalName="SuperHelper.Resources.urls.rhino-cn.json" />
    <EmbeddedResource Include="..\urls.json" Link="Resources\urls.100-gh.json" LogicalName="SuperHelper.Resources.urls.100-gh.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\SuperHelperIcon_128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="9.0.26244.12303-beta" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" Version="9.0.26244.12303-beta" ExcludeAssets="runtime" />
    <PackageReference Include="Eto.Serialization.Xaml" Version="2.11.0" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
